-  ASSERT_EQ(r.ex.applied.size(), 3u);
-  EXPECT_EQ(r.ex.applied[1], 2u);
-  EXPECT_EQ(r.ex.applied[2], 3u);
-  EXPECT_EQ(r.ex.resends_ignored, 2u);  // the engine already had both: exactly once by UserRefNum
-}
