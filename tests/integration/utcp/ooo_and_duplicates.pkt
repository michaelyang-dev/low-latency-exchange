# Receiver: out-of-order data is dropped with a duplicate ACK; an old duplicate is
# re-ACKed and ignored; a partially overlapping segment contributes its new bytes.
config rx_buffer=4000 mss=1000 iss=0
0      listen
0      < S 0:0(0) win 8000 mss 1000
0      > S. 0:0(0) ack 1 win 4000 mss 1000
0      < . 1:1(0) ack 1 win 8000
0.100  < P. 1001:2001(1000) ack 1 win 8000
0.100  > . 1:1(0) ack 1 win 4000
0.100  expect readable 0
0.200  < P. 1:1001(1000) ack 1 win 8000
0.200  > . 1:1(0) ack 1001 win 3000
0.300  < P. 1:1001(1000) ack 1 win 8000
0.300  > . 1:1(0) ack 1001 win 3000
0.400  < P. 501:1501(1000) ack 1 win 8000
0.400  > . 1:1(0) ack 1501 win 2500
0.400  expect readable 1500
0.500  read 1500
0.500  expect none
