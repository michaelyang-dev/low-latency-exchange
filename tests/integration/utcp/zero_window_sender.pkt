# The peer closes its window: the persist timer sends one-byte probes with backoff
# (answered with a zero window, so they never exhaust the retransmission limit); when
# the window reopens, the transfer completes without silly small segments.
config rx_buffer=4000 mss=1000 min_rto=0.2 initial_rto=1 max_retransmits=2
0      connect
0      > S 0:0(0) win 4000 mss 1000
0      < S. 0:0(0) ack 1 win 1000 mss 1000
0      > . 1:1(0) ack 1 win 4000
0.100  write 3000
0.100  > P. 1:1001(1000) ack 1 win 4000
0.110  < . 1:1(0) ack 1001 win 0
0.310  > P. 1001:1002(1) ack 1 win 4000
0.320  < . 1:1(0) ack 1001 win 0
0.710  > P. 1001:1002(1) ack 1 win 4000
0.720  < . 1:1(0) ack 1001 win 0
1.510  > P. 1001:1002(1) ack 1 win 4000
1.520  < . 1:1(0) ack 1001 win 0
3.110  > P. 1001:1002(1) ack 1 win 4000
3.120  < . 1:1(0) ack 1002 win 2000
3.120  > P. 1002:2002(1000) ack 1 win 4000
3.130  < . 1:1(0) ack 2002 win 2000
3.130  > P. 2002:3001(999) ack 1 win 4000
3.140  < . 1:1(0) ack 3001 win 2000
3.140  expect state ESTABLISHED
3.140  expect none
