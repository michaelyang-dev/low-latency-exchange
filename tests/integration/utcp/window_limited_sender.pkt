# The sender respects the peer's window and avoids silly-window segments: with a
# 1500-byte window and 1000-byte MSS it sends full segments as ACKs open room.
config rx_buffer=4000 mss=1000
0      connect
0      > S 0:0(0) win 4000 mss 1000
0      < S. 0:0(0) ack 1 win 1500 mss 1000
0      > . 1:1(0) ack 1 win 4000
0.100  write 3000
0.100  > P. 1:1001(1000) ack 1 win 4000
0.110  < . 1:1(0) ack 1001 win 1500
0.110  > P. 1001:2001(1000) ack 1 win 4000
0.120  < . 1:1(0) ack 2001 win 1500
0.120  > P. 2001:3001(1000) ack 1 win 4000
0.130  < . 1:1(0) ack 3001 win 1500
0.130  expect none
