# RFC 5961 §4: a SYN in a synchronized state (old or in-window) draws a challenge ACK.
config rx_buffer=4000 mss=1000
0      connect
0      > S 0:0(0) win 4000 mss 1000
0      < S. 0:0(0) ack 1 win 8000 mss 1000
0      > . 1:1(0) ack 1 win 4000
0.100  < S 0:0(0) win 8000 mss 1000
0.100  > . 1:1(0) ack 1 win 4000
0.200  < S 3000:3000(0) win 8000 mss 1000
0.200  > . 1:1(0) ack 1 win 4000
0.200  expect state ESTABLISHED
