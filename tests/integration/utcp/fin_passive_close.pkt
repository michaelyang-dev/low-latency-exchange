# Passive close: data with FIN -> CLOSE-WAIT; the application reads and closes ->
# LAST-ACK -> CLOSED on the ACK of our FIN.
config rx_buffer=4000 mss=1000 iss=0
0      listen
0      < S 0:0(0) win 8000 mss 1000
0      > S. 0:0(0) ack 1 win 4000 mss 1000
0      < . 1:1(0) ack 1 win 8000
0.100  < FP. 1:6(5) ack 1 win 8000
0.100  > . 1:1(0) ack 7 win 3994
0.100  expect state CLOSE-WAIT
0.100  expect event peer_fin
0.100  expect readable 5
0.200  read 5
0.200  close
0.200  > F. 1:1(0) ack 7 win 4000
0.200  expect state LAST-ACK
0.210  < . 7:7(0) ack 2 win 8000
0.210  expect state CLOSED
0.210  expect reason normal
0.210  expect event closed
